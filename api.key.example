# Copy this file to `api.key` (git-ignored) and fill it in. Every setting has a
# working default, so with no api.key at all the app runs fully offline in mock
# mode: AI feedback falls back to the built-in rule-based checks.
#
# api.key is read only by the dev/preview server (server/apiKey.js). The key is
# never sent to the browser, and real environment variables override this file.

# --- Provider: flip between rule-based and LLM ---------------------------------
GETAJOB_AI=mock          # mock | llm   (llm needs GROQ_API_KEY)

# --- LLM (Groq, OpenAI-compatible API) -----------------------------------------
GROQ_API_KEY=
LLM_MODEL=groq/openai/gpt-oss-20b
